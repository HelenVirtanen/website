---
import BlockTitle from '@moscowcss/ui/components/BlockTitle';
import SpeakerAvatar from '@moscowcss/ui/components/SpeakerAvatar';
import Prose from '@moscowcss/ui/components/Prose';
import { render, type CollectionEntry } from 'astro:content';
import { scheduleOf, slugOf } from '../content/catalog';
import { useTranslations, type Locale } from '../i18n';
import {
  section,
  inner,
  header,
  hint,
  list,
  row,
  portraitColumn,
  time,
  talkMain,
  talkTitle,
  speakerName,
  speakerRole,
  description,
  activityRow,
  activityTitle,
} from './ProgramSection.css';

interface Props {
  // Митап, чью программу показывает блок
  event: CollectionEntry<'events'>;
  // Доклады всех митапов языка страницы
  talks: CollectionEntry<'talks'>[];
  // Спикеры языка страницы
  speakers: CollectionEntry<'speakers'>[];
  // Язык страницы
  locale: Locale;
  id?: string;
}

const { event, talks, speakers, locale, id = 'program' } = Astro.props;
const t = useTranslations(locale);

const speakerBySlug = new Map(speakers.map((speaker) => [slugOf(speaker), speaker]));

const items = await Promise.all(
  scheduleOf(event, talks).map(async (item) => {
    if (item.kind !== 'talk') return item;
    const { Content } = await render(item.talk);
    const people = item.talk.data.speakers.flatMap((slug) => {
      const speaker = speakerBySlug.get(slug);
      return speaker ? [speaker.data] : [];
    });
    return { ...item, Content, people };
  }),
);
---

<section class={section} id={id} data-visual="program">
  <div class={inner}>
    <div class={header}>
      <BlockTitle>{t('program.title')}</BlockTitle>
      <p class={hint}>{t('program.hint')}</p>
    </div>

    <ul class={list}>
      {
        items.map((item) =>
          item.kind === 'talk' ? (
            <li class={row}>
              <div class={portraitColumn}>
                <p class={time}>{item.time}</p>
                <SpeakerAvatar src={item.people[0]?.photo.src} alt={item.people[0]?.photoAlt ?? ''} />
              </div>
              <div class={talkMain}>
                <h3 class={talkTitle}>{item.title}</h3>
                <p class={speakerName}>{item.people.map((person) => person.name).join(', ')}</p>
                <p class={speakerRole}>{item.people.map((person) => person.role).join(' · ')}</p>
              </div>
              <div class={description}>
                <Prose>
                  <item.Content />
                </Prose>
              </div>
            </li>
          ) : (
            <li class={activityRow}>
              <p class={time}>{item.time}</p>
              <p class={activityTitle}>{item.title}</p>
            </li>
          ),
        )
      }
    </ul>
  </div>
</section>
