---
import BlockTitle from '@moscowcss/ui/components/BlockTitle';
import type { CollectionEntry } from 'astro:content';
import ProgramList from '../components/ProgramList.astro';
import { scheduleOf } from '../content/catalog';
import { fillTemplate } from '../content/format';
import { useTranslations, type Locale } from '../i18n';
import { section, inner, header, hint } from './ProgramSection.css';

interface Props {
  // Митап, чью программу показывает блок
  event: CollectionEntry<'events'>;
  // Доклады всех митапов языка страницы
  talks: CollectionEntry<'talks'>[];
  // Спикеры языка страницы
  speakers: CollectionEntry<'speakers'>[];
  locale: Locale;
  // Тег вопросов спикерам из контента главной
  questionTag: string;
  id?: string;
}

const { event, talks, speakers, locale, questionTag, id = 'program' } = Astro.props;
const t = useTranslations(locale);
---

<section class={section} id={id} data-visual="program">
  <div class={inner}>
    <div class={header}>
      <BlockTitle>{t('program.title')}</BlockTitle>
      <p class={hint}>{fillTemplate(t('program.hint'), { tag: questionTag })}</p>
    </div>

    <ProgramList items={scheduleOf(event, talks)} speakers={speakers} locale={locale} />
  </div>
</section>
