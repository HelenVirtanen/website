---
import Prose from '@moscowcss/ui/components/Prose';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { localizePath, useTranslations, type Locale } from '../i18n';
import { section, inner, title, body, privacy, privacyLink } from './AboutSection.css';

interface Props {
  // Страница «о митапе» языка страницы
  page: CollectionEntry<'pages'>;
  locale: Locale;
}

const { page, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(page);
---

<section class={section} id="about">
  <div class={inner}>
    <h2 class={title}>{t('about.title')}</h2>
    <Prose class={body}>
      <Content />
    </Prose>
    <p class={privacy}>
      <a class={privacyLink} href={localizePath(locale, 'personal-data')}>{t('about.privacy')}</a>
    </p>
  </div>
</section>
