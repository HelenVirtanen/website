---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BlockTitle from '@moscowcss/ui/components/BlockTitle';
import { CardSlider, CardSlide } from '@moscowcss/ui/components/Card';
import OrganizerCard from '@moscowcss/ui/components/OrganizerCard';
import type { OrganizerEntry } from '../content/catalog';
import { contactsOf } from '../content/organizers';
import { useTranslations, type Locale } from '../i18n';
import { section, inner, slider, slide } from './OrganizersSection.css';

interface Props {
  // Организаторы языка страницы, уже отобранные по статусу; пусто — секции нет
  entries: OrganizerEntry[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const t = useTranslations(locale);

// Фото в файле — 2x от размера на странице (498px при 249px)
const PHOTO_SIZE = 498;
const AUTOPLAY_MS = 5000;

const cards = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Bio: entry.body?.trim() ? (await render(entry)).Content : undefined,
  })),
);
---

{
  cards.length > 0 && (
    <section class={section} id="organizers" data-visual="organizers">
      <div class={inner}>
        <CardSlider
          class={slider}
          prevLabel={t('slider.prev')}
          nextLabel={t('slider.next')}
          autoplayMs={AUTOPLAY_MS}
          autoplayLabel={t('slider.autoplay')}
          shuffle
          data-organizers
        >
          <BlockTitle slot="header">{t('organizers.title')}</BlockTitle>
          {cards.map(({ data, Bio }) => (
            <CardSlide class={slide}>
              <OrganizerCard
                name={data.name}
                contacts={contactsOf(data.contacts).map(({ kind, href, text }) => ({
                  href,
                  text,
                  label: t(`organizer.contact.${kind}`),
                }))}
              >
                {data.photo && (
                  <Fragment slot="photo">
                    <Image
                      src={data.photo}
                      alt=""
                      width={PHOTO_SIZE}
                      height={PHOTO_SIZE}
                      format="png"
                    />
                  </Fragment>
                )}
                {Bio && <Bio />}
              </OrganizerCard>
            </CardSlide>
          ))}
        </CardSlider>
      </div>
    </section>
  )
}
