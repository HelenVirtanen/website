---
import BlockTitle from '@moscowcss/ui/components/BlockTitle';
import Card, { CardSlider, CardSlide } from '@moscowcss/ui/components/Card';
import Prose from '@moscowcss/ui/components/Prose';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '../i18n';
import { section, inner, slider } from './FAQSection.css';

interface Props {
  // Вопросы языка страницы
  entries: CollectionEntry<'faq'>[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
const t = useTranslations(locale);

const cards = await Promise.all(
  [...entries]
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      title: entry.data.title,
      Content: (await render(entry)).Content,
    })),
);
---

<section class={section} data-visual="faq">
  <div class={inner}>
    <CardSlider class={slider} prevLabel={t('slider.prev')} nextLabel={t('slider.next')}>
      <BlockTitle slot="header">{t('faq.title')}</BlockTitle>
      {
        cards.map(({ title, Content }) => (
          <CardSlide>
            <Card title={title}>
              <Prose>
                <Content />
              </Prose>
            </Card>
          </CardSlide>
        ))
      }
    </CardSlider>
  </div>
</section>
