---
import { render } from 'astro:content';
import H1 from '@moscowcss/ui/components/H1';
import Paragraph from '@moscowcss/ui/components/Paragraph';
import ReviewDialog from '@moscowcss/ui/components/ReviewDialog';
import ReviewFilter from '@moscowcss/ui/components/ReviewFilter';
import ReviewSticker from '@moscowcss/ui/components/ReviewSticker';
import ReviewWall, { reviewHref, stickerHref } from '@moscowcss/ui/components/ReviewWall';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCatalog, slugOf } from '../content/catalog';
import { previewOf, publishedReviews, reviewCategories } from '../content/reviews';
import { optimizedPhoto, reviewImage } from '../content/speaker-image';
import { useTranslations } from '../i18n';
import type { PublicPage } from '../seo/pages';
import { main, inner, head } from './ReviewsPage.css';

interface Props {
  page: Extract<PublicPage, { kind: 'reviews' }>;
}

// Окно шириной 48rem: снимок на всю ширину с запасом под ретину.
const GALLERY_WIDTH = 1200;

const { page } = Astro.props;
const { locale, alternates, path } = page;
const { title, description } = page.entry.data;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const published = publishedReviews(catalog.reviews, locale);
const categories = reviewCategories(published);
const reviews = await Promise.all(
  published.map(async (entry) => ({
    entry,
    slug: slugOf(entry),
    image: await reviewImage(entry),
    gallery: await Promise.all(
      entry.data.gallery.map(async (item) => ({ ...(await optimizedPhoto(item.image, GALLERY_WIDTH)), alt: item.alt })),
    ),
    preview: previewOf(entry.rendered?.html ?? ''),
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout title={`${title} — ${t('site.name')}`} description={description} lang={locale} alternates={alternates}>
  <main id="main" tabindex="-1" class={main} data-pagefind-body>
    <div class={inner}>
      <div class={head}>
        <H1>{title}</H1>
        <Paragraph>{t('reviews.lead')}</Paragraph>
      </div>
      <ReviewWall data-visual="reviews">
        {
          categories.length > 1 && (
            <ReviewFilter
              slot="filter"
              options={categories.map((value) => ({ value, label: t(`reviews.group.${value}`) }))}
              allLabel={t('reviews.all')}
              groupLabel={t('reviews.filter')}
              statusTemplate={t('filter.status')}
            />
          )
        }
        {reviews.map(({ entry, slug, image, preview }) => (
          <li data-review-category={entry.data.category}>
            <ReviewSticker
              href={stickerHref(path, slug)}
              name={entry.data.name}
              category={t(`reviews.category.${entry.data.category}`)}
              role={entry.data.role}
              text={preview}
              image={image}
              seed={slug}
              data-review-sticker={slug}
            />
          </li>
        ))}
        <Fragment slot="dialogs">
          {reviews.map(({ entry, slug, image, gallery, Content }) => (
            <ReviewDialog
              slug={slug}
              name={entry.data.name}
              category={t(`reviews.category.${entry.data.category}`)}
              role={entry.data.role}
              image={image}
              gallery={gallery}
              closeHref={path}
              closeLabel={t('reviews.close')}
              shareHref={reviewHref(path, slug)}
              copyLabel={t('reviews.copy')}
              copiedLabel={t('reviews.copied')}
              copyFailedLabel={t('reviews.copyFailed')}
            >
              <Content />
            </ReviewDialog>
          ))}
        </Fragment>
      </ReviewWall>
    </div>
  </main>
</BaseLayout>
