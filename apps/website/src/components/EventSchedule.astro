---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import H2 from '@moscowcss/ui/components/H2';
import { useTranslations, type Locale } from '../i18n';
import type { ScheduleItem } from '../content/catalog';
import ProgramList from './ProgramList.astro';
import { root } from './EventSchedule.css';

const Tag = 'section';

interface Props extends HTMLAttributes<typeof Tag> {
  // Расписание митапа: доклады и перерывы по времени
  items: ScheduleItem<CollectionEntry<'talks'>>[];
  // Спикеры языка страницы: по ним доклад получает имена со ссылками
  speakers: CollectionEntry<'speakers'>[];
  locale: Locale;
}

const { items, speakers, locale, class: className, ...attrs } = Astro.props;
const t = useTranslations(locale);
---

<Tag class:list={[root, className]} {...attrs}>
  <H2>{t('event.schedule')}</H2>
  <ProgramList items={items} speakers={speakers} locale={locale} />
</Tag>
