---
import SpeakerAvatar from '@moscowcss/ui/components/SpeakerAvatar';
import Prose from '@moscowcss/ui/components/Prose';
import { render, type CollectionEntry } from 'astro:content';
import { slugOf, type ScheduleItem } from '../content/catalog';
import { speakerImage } from '../content/speaker-image';
import { localizePath, type Locale } from '../i18n';
import {
  list,
  row,
  portraitColumn,
  time,
  talkMain,
  talkTitle,
  talkLink,
  speakerName,
  speakerLink,
  speakerRole,
  description,
  activityRow,
  activityTitle,
} from './ProgramList.css';

// Программа митапа: на главной и на странице митапа один и тот же список докладов.
interface Props {
  // Расписание митапа: доклады и перерывы по времени
  items: ScheduleItem<CollectionEntry<'talks'>>[];
  // Спикеры языка страницы
  speakers: CollectionEntry<'speakers'>[];
  locale: Locale;
}

const { items, speakers, locale } = Astro.props;

const speakerBySlug = new Map(speakers.map((speaker) => [slugOf(speaker), speaker]));

const rows = await Promise.all(
  items.map(async (item) => {
    if (item.kind !== 'talk') return item;
    const { Content } = await render(item.talk);
    const people = item.talk.data.speakers.flatMap((slug) => {
      const speaker = speakerBySlug.get(slug);
      return speaker ? [{ ...speaker.data, href: localizePath(locale, `speakers/${slug}`) }] : [];
    });
    const lead = item.talk.data.speakers
      .map((slug) => speakerBySlug.get(slug))
      .find((speaker) => speaker !== undefined);
    const portrait = lead ? await speakerImage(lead) : undefined;
    const roles = people
      .map((person) => person.role)
      .filter(Boolean)
      .join(' · ');
    return { ...item, Content, people, portrait, roles, href: localizePath(locale, `talks/${slugOf(item.talk)}`) };
  }),
);
---

<ul class={list}>
  {
    rows.map((item) =>
      item.kind === 'talk' ? (
        <li class={row}>
          <div class={portraitColumn}>
            {item.time && <p class={time}>{item.time}</p>}
            <SpeakerAvatar src={item.portrait?.src} />
          </div>
          <div class={talkMain}>
            <h3 class={talkTitle}>
              <a class={talkLink} href={item.href}>
                {item.title}
              </a>
            </h3>
            <p class={speakerName}>
              {item.people.map((person, index) => (
                <>
                  {index > 0 && ', '}
                  <a class={speakerLink} href={person.href}>
                    {person.name}
                  </a>
                </>
              ))}
            </p>
            {item.roles && <p class={speakerRole}>{item.roles}</p>}
          </div>
          <div class={description}>
            <Prose>
              <item.Content />
            </Prose>
          </div>
        </li>
      ) : (
        <li class={activityRow}>
          {/* Пустая колонка времени держит заголовок на одной линии с докладами */}
          <p class={time}>{item.time}</p>
          <p class={activityTitle}>{item.title}</p>
        </li>
      ),
    )
  }
</ul>
