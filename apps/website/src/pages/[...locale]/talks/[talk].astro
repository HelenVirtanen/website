---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import H1 from '@moscowcss/ui/components/H1';
import Prose from '@moscowcss/ui/components/Prose';
import LinkList from '@moscowcss/ui/components/LinkList';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityPage from '../../../components/EntityPage.astro';
import { body, cover as coverClass, header } from '../../../components/EntityPage.css';
import { loadCatalog, localeOf, slugOf } from '../../../content/catalog';
import { eventDateParts, fillTemplate } from '../../../content/format';
import { TBD_COVER_PATH } from '../../../content/talk-cover';
import { localizePath, useTranslations } from '../../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../../seo/pages';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'talk').map((page) => ({
    params: { locale: localeParam(page.locale), talk: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'talk' }> };
const { locale, entry, alternates } = page;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const event = catalog.events.find(
  (item) => localeOf(item) === locale && slugOf(item) === entry.data.event,
);
if (!event) throw new Error(`${entry.id}: нет митапа «${entry.data.event}»`);
const speakers = entry.data.speakers.map((slug) => {
  const speaker = catalog.speakers.find((item) => localeOf(item) === locale && slugOf(item) === slug);
  if (!speaker) throw new Error(`${entry.id}: нет спикера «${slug}»`);
  return speaker;
});
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);

const { title, slidesUrl, videoUrl } = entry.data;
// Карточка анонса повторяет заголовок и имя спикера, заглушка TBD смысла не несёт: обе — с пустым alt.
const cover = entry.data.cover
  ? await getImage({ src: entry.data.cover, width: Math.min(1200, entry.data.cover.width), format: 'webp' })
  : undefined;
const coverImage = cover
  ? { src: cover.src, width: Number(cover.attributes['width']), height: Number(cover.attributes['height']) }
  : { src: TBD_COVER_PATH, width: 1200, height: 630 };
const eventDate = fillTemplate(t('date.long'), eventDateParts(event.data.date, locale));
const materials = [
  slidesUrl && { href: slidesUrl, label: t('talk.slides') },
  videoUrl && { href: videoUrl, label: t('talk.video') },
].filter((item): item is { href: string; label: string } => Boolean(item));
---

<BaseLayout
  title={`${title} — ${t('site.name')}`}
  description={fillTemplate(t('talk.description'), {
    speakers: speakers.map((speaker) => speaker.data.name).join(', '),
    event: event.data.tagline,
  })}
  lang={locale}
  alternates={alternates}
>
  <EntityPage>
    <div class={header}>
      <H1>{title}</H1>
      <img class={coverClass} src={coverImage.src} width={coverImage.width} height={coverImage.height} alt="" decoding="async" />
    </div>
    <Prose class={body}>
      <Content />
    </Prose>
    <LinkList
      title={t('talk.speakers')}
      items={speakers.map((speaker) => ({
        href: localizePath(locale, `speakers/${slugOf(speaker)}`),
        label: speaker.data.name,
        ...(speaker.data.role && { caption: speaker.data.role }),
      }))}
    />
    <LinkList
      title={t('talk.event')}
      items={[
        {
          href: localizePath(locale, `events/${slugOf(event)}`),
          label: event.data.tagline,
          caption: eventDate,
        },
      ]}
    />
    {materials.length > 0 && <LinkList title={t('talk.materials')} items={materials} />}
  </EntityPage>
</BaseLayout>
