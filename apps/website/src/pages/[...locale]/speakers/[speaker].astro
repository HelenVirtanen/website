---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import H1 from '@moscowcss/ui/components/H1';
import Paragraph from '@moscowcss/ui/components/Paragraph';
import Prose from '@moscowcss/ui/components/Prose';
import LinkList from '@moscowcss/ui/components/LinkList';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityPage from '../../../components/EntityPage.astro';
import { body, header, photo } from '../../../components/EntityPage.css';
import { loadCatalog, localeOf, slugOf, talksOfSpeaker, type SpeakerEntry } from '../../../content/catalog';
import { eventDateParts, fillTemplate } from '../../../content/format';
import { speakerImage } from '../../../content/speaker-image';
import { localizePath, useTranslations } from '../../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../../seo/pages';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'speaker').map((page) => ({
    params: { locale: localeParam(page.locale), speaker: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'speaker' }> };
const { locale, alternates } = page;
const entry = page.entry as SpeakerEntry;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const appearances = talksOfSpeaker(
  entry,
  catalog.talks.filter((talk) => localeOf(talk) === locale),
  catalog.events.filter((event) => localeOf(event) === locale),
);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);

const { name, role, links } = entry.data;
const image = await speakerImage(entry);
---

<BaseLayout
  title={`${name} — ${t('site.name')}`}
  description={role}
  lang={locale}
  alternates={alternates}
>
  <EntityPage>
    <div class={header}>
      <img class={photo} src={image.src} width={image.width} height={image.height} alt={image.alt} decoding="async" />
      <H1>{name}</H1>
      <Paragraph>{role}</Paragraph>
    </div>
    <Prose class={body}>
      <Content />
    </Prose>
    {
      appearances.length > 0 && (
        <LinkList
          title={t('speaker.talks')}
          items={appearances.flatMap(({ talk, event }) => [
            {
              href: localizePath(locale, `talks/${slugOf(talk)}`),
              label: talk.data.title,
              caption: `${event.data.tagline}, ${fillTemplate(t('date.long'), eventDateParts(event.data.date, locale))}`,
            },
          ])}
        />
      )
    }
    {
      appearances.length > 0 && (
        <LinkList
          title={t('speaker.events')}
          items={[...new Map(appearances.map(({ event }) => [slugOf(event), event])).values()].map((event) => ({
            href: localizePath(locale, `events/${slugOf(event)}`),
            label: event.data.tagline,
            caption: fillTemplate(t('date.long'), eventDateParts(event.data.date, locale)),
          }))}
        />
      )
    }
    {links && links.length > 0 && <LinkList title={t('speaker.links')} items={links.map((link) => ({ href: link.url, label: link.label }))} />}
  </EntityPage>
</BaseLayout>
