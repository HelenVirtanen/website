---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BlockTitle from '@moscowcss/ui/components/BlockTitle';
import Lightbox from '@moscowcss/ui/components/Lightbox';
import Prose from '@moscowcss/ui/components/Prose';
import TalkCard from '@moscowcss/ui/components/TalkCard';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { eventLabel } from '../../../content/archive';
import { loadCatalog, localeOf, slugOf, talksOfSpeaker, type SpeakerEntry } from '../../../content/catalog';
import { eventDateParts, fillTemplate } from '../../../content/format';
import { speakerImage } from '../../../content/speaker-image';
import { talkCoverImage } from '../../../content/talk-cover-image';
import { localizePath, useTranslations } from '../../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../../seo/pages';
import {
  action,
  actions,
  block,
  cards,
  chip,
  hero,
  heroText,
  inner,
  lead,
  main,
  portrait,
  portraitImage,
  prose,
  meetupChip,
  tagTones,
  tags,
  title,
} from '../../../components/DetailPage.css';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'speaker').map((page) => ({
    params: { locale: localeParam(page.locale), speaker: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'speaker' }> };
const { locale, alternates } = page;
const entry = page.entry as SpeakerEntry;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const appearances = talksOfSpeaker(
  entry,
  catalog.talks.filter((talk) => localeOf(talk) === locale),
  catalog.events.filter((event) => localeOf(event) === locale),
);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);
const hasBio = Boolean(entry.body?.trim());

const { name, role, links = [], photo } = entry.data;
const image = await speakerImage(entry);
// Крупно открываем только настоящее фото: аватар с инициалами увеличивать незачем.
const full = photo ? await getImage({ src: photo, width: Math.min(1400, photo.width), format: 'webp' }) : undefined;

const talks = await Promise.all(
  appearances.map(async ({ talk, event }) => ({
    href: localizePath(locale, `talks/${slugOf(talk)}`),
    title: talk.data.title,
    label: eventLabel(event),
    meta: `${event.data.tagline}, ${fillTemplate(t('date.long'), eventDateParts(event.data.date, locale))}`,
    image: talkCoverImage(talk),
  })),
);
const events = [...new Map(appearances.map(({ event }) => [slugOf(event), event])).values()];
---

<BaseLayout title={`${name} — ${t('site.name')}`} description={role ?? name} lang={locale} alternates={alternates}>
  <main id="main" tabindex="-1" class={main} data-pagefind-body>
    <div class={inner}>
      <div class={hero}>
        {
          full ? (
            <Lightbox dialogLabel={name} closeLabel={t('lightbox.close')} prevLabel={t('lightbox.prev')} nextLabel={t('lightbox.next')}>
              <a class={portrait} href={full.src} data-lightbox-item data-caption={name} aria-label={fillTemplate(t('lightbox.open'), { name })}>
                <img class={portraitImage} src={image.src} width={image.width} height={image.height} alt="" decoding="async" />
              </a>
            </Lightbox>
          ) : (
            <span class={portrait}>
              <img class={portraitImage} src={image.src} width={image.width} height={image.height} alt="" decoding="async" />
            </span>
          )
        }
        <div class={heroText}>
          <span class={chip}>{t('speaker.kicker')}</span>
          <h1 class={title}>{name}</h1>
          {role && <p class={lead}>{role}</p>}
          {
            events.length > 0 && (
              <ul class={tags} aria-label={t('speaker.events')}>
                {events.map((event, index) => (
                  <li>
                    <a class:list={[meetupChip, tagTones[index % tagTones.length]]} href={localizePath(locale, `events/${slugOf(event)}`)} title={event.data.tagline}>
                      {fillTemplate(t('speaker.meetup'), { label: eventLabel(event) })}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          {
            links.length > 0 && (
              <ul class={actions} aria-label={t('speaker.links')}>
                {links.map((link) => (
                  <li>
                    <a class={action} href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      {
        hasBio && (
          <Prose class={prose}>
            <Content />
          </Prose>
        )
      }

      {
        talks.length > 0 && (
          <section class={block}>
            <BlockTitle>{t('speaker.talks')}</BlockTitle>
            <ul class={cards}>
              {talks.map((item) => (
                <li>
                  <TalkCard href={item.href} title={item.title} label={item.label} meta={item.meta} image={item.image} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>
