---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import H1 from '@moscowcss/ui/components/H1';
import Paragraph from '@moscowcss/ui/components/Paragraph';
import Prose from '@moscowcss/ui/components/Prose';
import LinkList from '@moscowcss/ui/components/LinkList';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityPage from '../../../components/EntityPage.astro';
import EventSchedule from '../../../components/EventSchedule.astro';
import { body, header } from '../../../components/EntityPage.css';
import { loadCatalog, localeOf, scheduleOf, type EventEntry } from '../../../content/catalog';
import { eventWhen, venueLine } from '../../../content/format';
import { eventLinksOf } from '../../../content/event-links';
import { buildNow } from '../../../content/now';
import { useTranslations } from '../../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../../seo/pages';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'event').map((page) => ({
    params: { locale: localeParam(page.locale), event: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'event' }> };
const { locale, entry, alternates } = page;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const inLocale = <T extends { id: string }>(entries: T[]): T[] =>
  entries.filter((item) => localeOf(item) === locale);
const speakers = inLocale(catalog.speakers) as CollectionEntry<'speakers'>[];
const schedule = scheduleOf(entry as EventEntry, inLocale(catalog.talks) as CollectionEntry<'talks'>[]);

const { tagline, venue } = entry.data;
const dateTime = eventWhen(entry.data, locale, { withTime: t('hero.dateTime'), dateOnly: t('date.long') });
const place = venueLine(venue);
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);

const links = eventLinksOf(entry, buildNow(), {
  registration: t('event.registration'),
  stream: t('event.stream'),
  recording: t('event.recording'),
  photos: t('event.photos'),
  map: t('event.map'),
});
---

<BaseLayout
  title={`${tagline} — ${t('site.name')}`}
  description={`${tagline}. ${dateTime}, ${place}`}
  lang={locale}
  alternates={alternates}
>
  <EntityPage>
    <div class={header}>
      <H1>{tagline}</H1>
      <Paragraph>{dateTime}</Paragraph>
      <Paragraph>{place}</Paragraph>
    </div>
    <Prose class={body}>
      <Content />
    </Prose>
    {schedule.length > 0 && <EventSchedule items={schedule} speakers={speakers} locale={locale} />}
    {links.length > 0 && <LinkList title={t('event.links')} items={links} />}
  </EntityPage>
</BaseLayout>
