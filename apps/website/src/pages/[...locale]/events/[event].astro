---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import H1 from '@moscowcss/ui/components/H1';
import Paragraph from '@moscowcss/ui/components/Paragraph';
import Prose from '@moscowcss/ui/components/Prose';
import LinkList from '@moscowcss/ui/components/LinkList';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityPage from '../../../components/EntityPage.astro';
import EventSchedule from '../../../components/EventSchedule.astro';
import { body, header } from '../../../components/EntityPage.css';
import { loadCatalog, localeOf, scheduleOf, type EventEntry } from '../../../content/catalog';
import { eventDateParts, fillTemplate } from '../../../content/format';
import { useTranslations } from '../../../i18n';
import { localeParam, pagesOfKind, publicPagesOf, type PublicPage } from '../../../seo/pages';

export const getStaticPaths = (async () => {
  const catalog = await loadCatalog();
  return pagesOfKind(publicPagesOf(catalog), 'event').map((page) => ({
    params: { locale: localeParam(page.locale), event: page.slugParam },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Extract<PublicPage, { kind: 'event' }> };
const { locale, entry, alternates } = page;
const t = useTranslations(locale);

const catalog = await loadCatalog();
const inLocale = <T extends { id: string }>(entries: T[]): T[] =>
  entries.filter((item) => localeOf(item) === locale);
const speakers = inLocale(catalog.speakers);
const schedule = scheduleOf(entry as EventEntry, inLocale(catalog.talks));

const { tagline, venue, date, registrationUrl, streamUrl, recordingUrl } = entry.data;
const dateTime = fillTemplate(t('hero.dateTime'), eventDateParts(date, locale));
const place = `${venue.name}, ${venue.address}`;
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);

const links = [
  registrationUrl && { href: registrationUrl, label: t('event.registration') },
  streamUrl && { href: streamUrl, label: t('event.stream') },
  recordingUrl && { href: recordingUrl, label: t('event.recording') },
  venue.mapUrl && { href: venue.mapUrl, label: t('event.map') },
].filter((item): item is { href: string; label: string } => Boolean(item));
---

<BaseLayout
  title={`${tagline} — ${t('site.name')}`}
  description={`${tagline}. ${dateTime}, ${venue.address}`}
  lang={locale}
  alternates={alternates}
>
  <EntityPage>
    <div class={header}>
      <H1>{tagline}</H1>
      <Paragraph>{dateTime}</Paragraph>
      <Paragraph>{place}</Paragraph>
    </div>
    <Prose class={body}>
      <Content />
    </Prose>
    {schedule.length > 0 && <EventSchedule items={schedule} speakers={speakers} locale={locale} />}
    {links.length > 0 && <LinkList title={t('event.links')} items={links} />}
  </EntityPage>
</BaseLayout>
