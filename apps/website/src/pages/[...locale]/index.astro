---
import type { GetStaticPaths } from 'astro';
import CallToAction from '@moscowcss/ui/components/CallToAction';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutSection from '../../sections/AboutSection.astro';
import HeroSection from '../../sections/HeroSection.astro';
import ProgramSection from '../../sections/ProgramSection.astro';
import PartnerSection from '../../sections/PartnerSection.astro';
import FAQSection from '../../sections/FAQSection.astro';
import OrganizersSection from '../../sections/OrganizersSection.astro';
import PastEventsSection from '../../sections/PastEventsSection.astro';
import { loadCatalog, localeOf, pastEvents, upcomingEvent } from '../../content/catalog';
import { buildNow } from '../../content/now';
import { organizersByStatus } from '../../content/organizers';
import { defaultLocale, localizePath, locales, useTranslations, type Locale } from '../../i18n';

// Маршрут `[...locale]`: у языка по умолчанию параметр пустой, поэтому ru живёт в `/`, en в `/en/`.
export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const now = buildNow();

// Каталог проверяется на сборке: битая ссылка или разошедшийся перевод роняют build.
const catalog = await loadCatalog();
const inLocale = <T extends { id: string }>(entries: T[]): T[] =>
  entries.filter((entry) => localeOf(entry) === locale);

const page = inLocale(catalog.pages).find((entry) => entry.id === `${locale}/index`);
if (!page) throw new Error(`Missing page content: pages/${locale}/index.md`);

const events = inLocale(catalog.events);
const featured = upcomingEvent(events, now);
const partner = featured?.event.data.partner
  ? inLocale(catalog.partners).find((entry) => entry.id === `${locale}/${featured.event.data.partner}`)
  : undefined;

const organizers = organizersByStatus(inLocale(catalog.organizers), 'current');

const alternates = locales.map((code) => ({ locale: code, path: localizePath(code) }));
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  lang={locale}
  alternates={alternates}
>
  <main id="main">
    {featured && <HeroSection event={featured.event} locale={locale} past={featured.past} />}
    {
      featured && (
        <ProgramSection
          event={featured.event}
          talks={inLocale(catalog.talks)}
          speakers={inLocale(catalog.speakers)}
          locale={locale}
          questionTag={page.data.questionTag}
        />
      )
    }
    {partner && featured && <PartnerSection partner={partner} event={featured.event} locale={locale} />}
    <FAQSection entries={inLocale(catalog.faq).filter((entry) => !entry.data.draft)} locale={locale} />
    <OrganizersSection entries={organizers} locale={locale} />
    <AboutSection page={page} locale={locale} />
    <PastEventsSection events={pastEvents(events, now)} locale={locale} />
    {
      featured && !featured.past && featured.event.data.registrationUrl && (
        <CallToAction href={featured.event.data.registrationUrl} aria-label={t('hero.registerLabel')}>
          {t('hero.register')}
        </CallToAction>
      )
    }
  </main>
</BaseLayout>
