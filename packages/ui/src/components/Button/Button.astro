---
import type { HTMLAttributes } from 'astro/types';
import { button, nav } from './Button.css';

interface OwnProps {
  /** Размер: обычный или уменьшенный под шапку */
  size?: 'default' | 'nav';
}

interface LinkProps extends HTMLAttributes<'a'>, OwnProps {
  /** Адрес перехода — рендер как ссылка вместо кнопки */
  href: string;
}

interface ButtonProps extends HTMLAttributes<'button'>, OwnProps {
  href?: undefined;
}

type Props = LinkProps | ButtonProps;

const props = Astro.props as Props;
const { class: className, href, size = 'default', type = 'button', ...attrs } = props;
const classes = [button, size === 'nav' && nav, className];
---

{href != null ? (
  <a href={href} class:list={classes} {...attrs}><slot /></a>
) : (
  <button type={type} class:list={classes} {...attrs}><slot /></button>
)}
