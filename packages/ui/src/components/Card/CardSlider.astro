---
import type { HTMLAttributes } from 'astro/types';
import { ArrowLong } from '@moscowcss/icons';
import {
  head,
  nav,
  navButton,
  navButtonIcon,
  navButtonIconPrev,
  root,
  swiper,
} from './CardSlider.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Подпись кнопки «назад» для скринридера */
  prevLabel: string;
  /** Подпись кнопки «вперёд» для скринридера */
  nextLabel: string;
  /** Листать самому через столько миллисекунд, по кругу; без значения лента листается только стрелками */
  autoplayMs?: number;
  /** Перемешать карточки при загрузке */
  shuffle?: boolean;
}

const { prevLabel, nextLabel, autoplayMs, shuffle = false, class: className, ...attrs } = Astro.props;
---
<Tag
  class:list={[root, className]}
  data-card-slider
  data-card-slider-autoplay={autoplayMs}
  data-card-slider-shuffle={shuffle || undefined}
  {...attrs}
>
  <div class={head}>
    <slot name="header" />
    <div class={nav}>
      <button type="button" class={navButton} data-card-slider-prev aria-label={prevLabel}>
        <ArrowLong class:list={[navButtonIcon, navButtonIconPrev]} preserveAspectRatio="none" aria-hidden="true" />
      </button>
      <button type="button" class={navButton} data-card-slider-next aria-label={nextLabel}>
        <ArrowLong class={navButtonIcon} preserveAspectRatio="none" aria-hidden="true" />
      </button>
    </div>
  </div>
  <div class:list={[swiper, 'swiper']} data-card-slider-container>
    <div class="swiper-wrapper">
      <slot />
    </div>
  </div>
</Tag>

<script>
  import { setupCardSlider } from './CardSlider.client';

  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-card-slider]').forEach(setupCardSlider);
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
