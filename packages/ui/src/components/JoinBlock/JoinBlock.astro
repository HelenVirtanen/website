---
import type { HTMLAttributes } from 'astro/types';
import Card from '../Card/Card.astro';
import BlockTitle from '../BlockTitle/BlockTitle.astro';
import CardRow from '../Card/CardRow.astro';
import { orgLink, root, title, row } from './JoinBlock.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Заголовок блока */
  title: string;
  /** Заголовок карточки «стать спикером» */
  speakerTitle: string;
  /** Абзац карточки спикера */
  speakerIntro: string;
  /** Текст перед ссылками на организаторов; пробел до ссылок ставит компонент */
  speakerContactPrefix: string;
  /** Текст после ссылок на организаторов */
  speakerContactSuffix: string;
  /** Заголовок карточки «стать оргом» */
  orgTitle: string;
  /** Строки карточки орга, каждая с новой строки */
  orgLines: string[];
}

const {
  title: heading,
  speakerTitle,
  speakerIntro,
  speakerContactPrefix,
  speakerContactSuffix,
  orgTitle,
  orgLines,
  class: className,
  ...attrs
} = Astro.props;
---
<Tag class:list={[root, className]} {...attrs}>
  <BlockTitle white class={title}>{heading}</BlockTitle>
  <CardRow class={row}>
    <Card title={speakerTitle}>
      {speakerIntro}
      <br />
      {speakerContactPrefix}{' '}
      <a href="https://t.me/RinaPa" class={orgLink} target="_blank" rel="noopener noreferrer">@RinaPa</a>
      {', '}
      <a href="https://t.me/DreamShaded" class={orgLink} target="_blank" rel="noopener noreferrer">@DreamShaded</a>
      {', '}
      <a href="https://t.me/Ppppst" class={orgLink} target="_blank" rel="noopener noreferrer">@Ppppst</a>
      {speakerContactSuffix}
    </Card>
    <Card title={orgTitle}>
      {
        orgLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))
      }
    </Card>
  </CardRow>
</Tag>
