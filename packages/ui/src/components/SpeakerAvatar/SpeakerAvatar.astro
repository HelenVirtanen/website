---
import type { HTMLAttributes } from 'astro/types';
import { frame, image, placeholder } from './SpeakerAvatar.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** URL фото спикера; без src показывается заглушка */
  src?: string;
}

const { src, class: className, ...attrs } = Astro.props;
---
<Tag class:list={[frame, className]} {...attrs}>
  {
    src ? (
      <img class={image} src={src} alt="" loading="lazy" decoding="async" />
    ) : (
      <span class={placeholder} />
    )
  }
</Tag>
