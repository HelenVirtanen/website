---
import type { ComponentProps } from 'astro/types';
import { Snowflake, Spring } from '@moscowcss/icons';
import IconToggle from '../IconToggle';

type Props = ComponentProps<typeof IconToggle> & {
  /** Что падает: от этого зависит значок */
  kind?: 'springs' | 'snow';
};

const { kind = 'springs', ...attrs } = Astro.props;
---
<IconToggle crossed data-decor-toggle hidden {...attrs}>
  {kind === 'snow' ? <Snowflake /> : <Spring />}
</IconToggle>
