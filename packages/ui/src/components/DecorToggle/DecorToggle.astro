---
import type { HTMLAttributes } from 'astro/types';
import { box, option, root } from './DecorToggle.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Подпись чекбокса, который выключает падающие фигуры */
  label: string;
}

const { label, class: className, ...attrs } = Astro.props;
---
<Tag class:list={[root, className]} data-decor-toggle hidden {...attrs}>
  <label class={option}>
    <input class={box} type="checkbox" data-decor-off />
    {label}
  </label>
</Tag>
