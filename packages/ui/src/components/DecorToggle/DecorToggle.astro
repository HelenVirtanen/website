---
import type { HTMLAttributes } from 'astro/types';
import { box, option, root } from './DecorToggle.css';

const Tag = 'div';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Подпись чекбокса, который выключает падающие фигуры */
  offLabel: string;
  /** Подпись чекбокса, который меняет пружинки на снежинки */
  snowLabel: string;
}

const { offLabel, snowLabel, class: className, ...attrs } = Astro.props;
---
<Tag class:list={[root, className]} data-decor-toggle hidden {...attrs}>
  <label class={option}>
    <input class={box} type="checkbox" data-decor-off />
    {offLabel}
  </label>
  <label class={option}>
    <input class={box} type="checkbox" data-decor-snow />
    {snowLabel}
  </label>
</Tag>
