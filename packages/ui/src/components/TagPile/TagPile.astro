---
import type { HTMLAttributes } from 'astro/types';
import { root, tag, tones } from './TagPile.css';

const Tag = 'ul';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Темы на плашках в исходном порядке */
  tags: string[];
  /** Доступное имя списка тем */
  label: string;
  /** Когда куча начинает падать: сразу после загрузки или когда попадёт на экран */
  trigger?: 'load' | 'visible';
  /** Во сколько раз медленнее обычного падают плашки, от 1 до 4 */
  pace?: number;
  /** Через сколько мс лежащая плашка проваливается вниз и падает заново сверху; без значения куча лежит */
  restMs?: number;
}

const { tags, label, trigger = 'load', pace = 1, restMs, class: className, ...attrs } = Astro.props;
---

<Tag
  class:list={[root, className]}
  aria-label={label}
  data-tag-pile
  data-tones={JSON.stringify(tones)}
  data-trigger={trigger}
  data-pace={String(pace)}
  data-rest-ms={restMs === undefined ? undefined : String(restMs)}
  {...attrs}
>
  {
    tags.map((name, index) => (
      <li class:list={[tag, tones[index % tones.length]]} data-tag-pile-item>
        {name}
      </li>
    ))
  }
</Tag>

<script>
  import { setupTagPile } from './TagPile.client';

  document.querySelectorAll<HTMLElement>('[data-tag-pile]').forEach(setupTagPile);
</script>
