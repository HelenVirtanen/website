---
import type { HTMLAttributes } from 'astro/types';
import { Close } from '@moscowcss/icons';
import BurgerButton from '../BurgerButton';
import Button from '../Button';
import DecorToggle from '../DecorToggle';
import ThemeToggle from '../ThemeToggle';
import {
  root,
  bar,
  home,
  links,
  link,
  actions,
  burger,
  closeButton,
  closeIcon,
  telegram,
  toggles,
  overlayToggles,
  overlay,
  overlayLinks,
  overlayLink,
  overlayFooter,
} from './NavBar.css';

const Tag = 'nav';
const MENU_ID = 'nav-menu';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Пункты навигации: адрес, подпись и `aria-current` у раздела текущей страницы */
  links: { href: string; label: string; current?: 'page' | 'true' }[];
  /** URL канала или чата в Telegram */
  telegramHref: string;
  /** Подпись кнопки со ссылкой на Telegram */
  telegramButtonLabel: string;
  /** Название кнопки падающих фигур */
  decorLabel: string;
  /** Что падает: от этого зависит значок кнопки */
  decorKind?: 'springs' | 'snow';
  /** Название кнопки тёмной темы */
  themeLabel: string;
  /** Доступное имя кнопки открытия меню */
  menuLabel: string;
  /** Доступное имя кнопки закрытия меню */
  closeLabel: string;
  /** Адрес главной: логотип слева ведёт на неё; без адреса логотипа нет */
  homeHref?: string;
  /** Доступное имя ссылки на главную */
  homeLabel?: string;
  /** Видимый текст логотипа */
  homeText?: string;
}

const {
  links: navLinks,
  telegramHref,
  telegramButtonLabel,
  decorLabel,
  decorKind = 'springs',
  themeLabel,
  menuLabel,
  closeLabel,
  homeHref,
  homeLabel,
  homeText,
  class: className,
  ...attrs
} = Astro.props;

const external = { target: '_blank', rel: 'noopener noreferrer' } as const;
---

<Tag class:list={[root, className]} data-navbar {...attrs}>
  <div class={bar}>
    {
      homeHref && (
        <a class={home} href={homeHref} aria-label={homeLabel}>
          {homeText}
        </a>
      )
    }
    <ul class={links}>
      {
        navLinks.map((item) => (
          <li>
            <a class={link} href={item.href} aria-current={item.current}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class={actions}>
      {Astro.slots.has('locale') && <slot name="locale" />}
      <div class={toggles}>
        <ThemeToggle label={themeLabel} />
        <DecorToggle label={decorLabel} kind={decorKind} />
      </div>
      <div class={telegram}>
        <Button href={telegramHref} size="nav" {...external}>{telegramButtonLabel}</Button>
      </div>
      <div class={burger}>
        <BurgerButton controls={MENU_ID} aria-label={menuLabel} />
      </div>
      <button type="button" class={closeButton} aria-label={closeLabel} data-nav-close>
        <Close class={closeIcon} />
      </button>
    </div>
  </div>
  <div id={MENU_ID} class={overlay} data-nav-menu hidden>
    <ul class={overlayLinks} data-nav-links>
      {
        navLinks.map((item) => (
          <li>
            <a class={overlayLink} href={item.href} aria-current={item.current}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class={overlayFooter}>
      <div class={overlayToggles}>
        <ThemeToggle label={themeLabel} />
        <DecorToggle label={decorLabel} kind={decorKind} />
      </div>
      <Button href={telegramHref} size="nav" {...external}>{telegramButtonLabel}</Button>
    </div>
  </div>
</Tag>

<script>
  import { setupNavBar } from './NavBar.client';

  document.querySelectorAll<HTMLElement>('[data-navbar]').forEach(setupNavBar);
</script>
