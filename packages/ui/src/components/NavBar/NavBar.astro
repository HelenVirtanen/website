---
import type { HTMLAttributes } from 'astro/types';
import { Close } from '@moscowcss/icons';
import BurgerButton from '../BurgerButton';
import TgLinkButton from '../TgLinkButton';
import {
  root,
  burger,
  links,
  link,
  overlay,
  overlayClose,
  overlayCloseIcon,
  overlayLinks,
  overlayLink,
} from './NavBar.css';

const Tag = 'nav';
const MENU_ID = 'nav-menu';

interface Props extends HTMLAttributes<typeof Tag> {
  /** Пункты навигации: якорь и подпись */
  links: { href: string; label: string }[];
  /** URL канала или чата в Telegram */
  telegramHref: string;
  /** Доступное имя ссылки на Telegram */
  telegramLabel: string;
  /** Доступное имя кнопки открытия меню */
  menuLabel: string;
  /** Доступное имя кнопки закрытия меню */
  closeLabel: string;
}

const { links: navLinks, telegramHref, telegramLabel, menuLabel, closeLabel, class: className, ...attrs } =
  Astro.props;
---

<Tag class:list={[root, className]} data-navbar {...attrs}>
  <div class={burger}>
    <BurgerButton controls={MENU_ID} aria-label={menuLabel} />
  </div>
  <ul class={links}>
    {navLinks.map((item) => (
      <li>
        <a class={link} href={item.href}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  {Astro.slots.has('locale') && <slot name="locale" />}
  <TgLinkButton
    href={telegramHref}
    aria-label={telegramLabel}
    target="_blank"
    rel="noopener noreferrer"
  />
  <div id={MENU_ID} class={overlay} data-nav-menu hidden>
    <button type="button" class={overlayClose} aria-label={closeLabel} data-nav-close>
      <Close class={overlayCloseIcon} />
    </button>
    <ul class={overlayLinks} data-nav-links>
      {navLinks.map((item) => (
        <li>
          <a class={overlayLink} href={item.href}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Tag>

<script>
  import { setupNavBar } from './NavBar.client';

  document.querySelectorAll<HTMLElement>('[data-navbar]').forEach(setupNavBar);
</script>
